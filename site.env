# Settings read by site.sh (the script itself is the same in every landing-page repo).
NAME=b19-landing                 # container name, and the folder /opt/b19-landing on the server
DOMAIN=b19studio.net
ALIASES=www.b19studio.net
PUBLIC='site/'                   # static files copied into dist/ before the build
BUILD='python3 tools/build.py'   # writes the pages into $OUT_DIR (dist/)
MEDIA_DIRS=audio                 # dist/audio/ — not in git, uploaded only when changed

PREVIEW_PORT=8083                # ./site.sh preview -> http://2.28.230.117:8083/

# one-time move from the old setup (git clone in /opt/b19lp + hand-written proxy block)
LEGACY_SEED=/opt/b19lp/site
LEGACY_MARK='# --- B19 (b19studio.net) ---'
